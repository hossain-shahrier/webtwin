{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "PORT=8060 uv run python main.py",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/api"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. DATABASE_URL=postgresql+psycopg://webtwin:webtwin@127.0.0.1:5434/webtwin uv run python scripts/migrate.py",
        "cwd": "apps/api"
      }
    },
    "dev:postgres": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "WEBTWIN_STORE=postgres DATABASE_URL=postgresql+psycopg://webtwin:webtwin@127.0.0.1:5434/webtwin PORT=8060 uv run python main.py",
        "cwd": "apps/api"
      }
    },
    "sync-kg": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. WEBTWIN_STORE=${WEBTWIN_STORE:-postgres} uv run python scripts/sync_kg.py",
        "cwd": "apps/api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run mypy .",
        "cwd": "apps/api"
      }
    }
  }
}
